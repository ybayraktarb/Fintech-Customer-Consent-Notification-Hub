{
  "name": "musteri-onay-server",
  "version": "1.0.0",
  "private": true,
  "description": "Müşteri Onay ve Bildirim Sistemi - Backend Wall & Entity Servisi",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "tsc",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:unit": "jest src/tests/wallService.test.ts",
    "test:security": "jest src/tests/wallSecurity.test.ts",
    "test:e2e": "jest src/tests/e2eFlow.test.ts",
    "test:relay": "jest src/tests/outboxRelay.test.ts",
    "test:idempotency": "jest src/tests/idempotentConsumer.test.ts",
    "test:trace": "jest src/tests/correlationTracing.test.ts",
    "test:metrics": "jest src/tests/metrics.test.ts",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "ts-node -T prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node -T prisma/seed.ts",
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@rubiklabs/nestjs-jacpol": "^1.0.1",
    "amqplib": "^2.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.9",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "prisma": "^5.22.0",
    "rimraf": "^5.0.7",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
