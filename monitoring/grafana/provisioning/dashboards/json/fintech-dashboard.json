        {
          "expr": "worker_dlq_messages_total + outbox_failed_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Transactional Outbox & Relay Performance",
      "type": "row"
    },
    {
      "id": 6,
      "title": "Outbox Pending Queue Depth (Lag Trend)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "outbox_pending_messages",
          "legendFormat": "Pending Outbox Messages",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      }
    },
    {
      "id": 7,
      "title": "Outbox Publish & ACK Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "rate(outbox_published_total[30s])",
          "legendFormat": "Publish & ACK Rate (msg/s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "color": { "fixedColor": "green", "mode": "fixed" },
          "unit": "reqps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "RabbitMQ Broker & Queue Saturation",
      "type": "row"
    },
    {
      "id": 8,
      "title": "RabbitMQ Queue Depth (notification.queue)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages{queue=\"notification.queue\"}",
          "legendFormat": "Total Queue Messages",
          "refId": "A"
        },
        {
          "expr": "rabbitmq_queue_messages_ready{queue=\"notification.queue\"}",
          "legendFormat": "Ready Messages",
          "refId": "B"
        },
        {
          "expr": "rabbitmq_queue_messages_unacked{queue=\"notification.queue\"}",
          "legendFormat": "Unacknowledged Messages",
          "refId": "C"
        }
