    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103,
      "title": "Worker Consumer & Idempotency Rates",
      "type": "row"
    },
    {
      "id": 9,
      "title": "Processed vs. Idempotent Skip Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "rate(worker_processed_messages_total[30s])",
          "legendFormat": "Processed Notifications (msg/s)",
          "refId": "A"
        },
        {
          "expr": "rate(worker_idempotent_skips_total[30s])",
          "legendFormat": "Idempotent Skips (skip/s)",
