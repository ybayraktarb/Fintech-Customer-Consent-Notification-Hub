    {
      "id": 10,
      "title": "Dead Letter Queue & Terminal Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "worker_dlq_messages_total",
          "legendFormat": "Worker DLQ Messages",
          "refId": "A"
        },
        {
          "expr": "outbox_failed_total",
          "legendFormat": "Outbox Terminal Failures",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
