      "id": 100,
      "title": "System Executive Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Outbox Pending Messages (Lag)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "outbox_pending_messages",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Outbox Published Total",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "targets": [
        {
          "expr": "outbox_published_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 3,
      "title": "Worker Processed Notifications",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "targets": [
        {
          "expr": "worker_processed_messages_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 4,
      "title": "Idempotent Skips Total",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "targets": [
        {
          "expr": "worker_idempotent_skips_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
